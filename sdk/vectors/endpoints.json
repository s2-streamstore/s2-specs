{
  "cases": [
    {"rule": "C3", "name": "defaults", "basin": "my-basin-1", "expect": {"account_origin": "https://a.s2.dev", "basin_origin": "https://my-basin-1.b.s2.dev", "s2_basin_header": false}},
    {"rule": "C3", "name": "host and port, no scheme", "endpoints": {"account": "localhost:8080", "basin": "localhost:8080"}, "basin": "my-basin-1", "expect": {"account_origin": "https://localhost:8080", "basin_origin": "https://localhost:8080", "s2_basin_header": true}},
    {"rule": "C3", "name": "http with a trailing slash", "endpoints": {"account": "http://localhost:8080/", "basin": "http://localhost:8080/"}, "basin": "my-basin-1", "expect": {"account_origin": "http://localhost:8080", "basin_origin": "http://localhost:8080", "s2_basin_header": true}},
    {"rule": "C3", "name": "bracketed IPv6", "endpoints": {"account": "[::1]:8080", "basin": "[::1]:8080"}, "basin": "my-basin-1", "expect": {"account_origin": "https://[::1]:8080", "basin_origin": "https://[::1]:8080", "s2_basin_header": true}},
    {"rule": "C3", "name": "one endpoint serving both", "endpoints": {"account": "aws.s2.dev", "basin": "aws.s2.dev"}, "basin": "my-basin-1", "expect": {"account_origin": "https://aws.s2.dev", "basin_origin": "https://aws.s2.dev", "s2_basin_header": true}},
    {"rule": "C3", "name": "basin placeholder", "endpoints": {"account": "https://a.example.com", "basin": "https://{basin}.b.example.com"}, "basin": "my-basin-1", "expect": {"account_origin": "https://a.example.com", "basin_origin": "https://my-basin-1.b.example.com", "s2_basin_header": false}},
    {"rule": "C3", "name": "account endpoint alone", "endpoints": {"account": "https://a.example.com"}, "basin": "my-basin-1", "expect": {"error": "ValidationError"}},
    {"rule": "C3", "name": "basin endpoint alone", "endpoints": {"basin": "https://{basin}.b.example.com"}, "basin": "my-basin-1", "expect": {"error": "ValidationError"}},
    {"rule": "C3", "name": "path", "endpoints": {"account": "https://example.com/v1", "basin": "https://example.com"}, "basin": "my-basin-1", "expect": {"error": "ValidationError"}},
    {"rule": "C3", "name": "placeholder in the path", "endpoints": {"account": "example.com", "basin": "example.com/{basin}"}, "basin": "my-basin-1", "expect": {"error": "ValidationError"}},
    {"rule": "C3", "name": "query", "endpoints": {"account": "https://example.com?x=1", "basin": "https://example.com"}, "basin": "my-basin-1", "expect": {"error": "ValidationError"}},
    {"rule": "C3", "name": "fragment", "endpoints": {"account": "https://example.com#x", "basin": "https://example.com"}, "basin": "my-basin-1", "expect": {"error": "ValidationError"}},
    {"rule": "C3", "name": "user info", "endpoints": {"account": "https://user@example.com", "basin": "https://example.com"}, "basin": "my-basin-1", "expect": {"error": "ValidationError"}},
    {"rule": "C3", "name": "unsupported scheme", "endpoints": {"account": "ftp://example.com", "basin": "ftp://example.com"}, "basin": "my-basin-1", "expect": {"error": "ValidationError"}},
    {"rule": "C3", "name": "different schemes", "endpoints": {"account": "http://example.com", "basin": "https://example.com"}, "basin": "my-basin-1", "expect": {"error": "ValidationError"}},
    {"rule": "C3", "name": "placeholder with an IP address", "endpoints": {"account": "127.0.0.1", "basin": "{basin}.127.0.0.1"}, "basin": "my-basin-1", "expect": {"error": "ValidationError"}},
    {"rule": "C3", "name": "placeholder with bracketed IPv6", "endpoints": {"account": "[::1]", "basin": "{basin}.[::1]"}, "basin": "my-basin-1", "expect": {"error": "ValidationError"}},
    {"rule": "C3", "name": "malformed bracketed IPv6", "endpoints": {"account": "[::1::1]", "basin": "[::1::1]"}, "basin": "my-basin-1", "expect": {"error": "ValidationError"}},
    {"rule": "C3", "name": "placeholder with malformed bracketed IPv6", "endpoints": {"account": "example.com", "basin": "{basin}.[::1::1]"}, "basin": "my-basin-1", "expect": {"error": "ValidationError"}},
    {"rule": "C3", "name": "placeholder without its dot", "endpoints": {"account": "example.com", "basin": "{basin}example.com"}, "basin": "my-basin-1", "expect": {"error": "ValidationError"}},
    {"rule": "C3", "name": "bare IPv6", "endpoints": {"account": "::1", "basin": "::1"}, "basin": "my-basin-1", "expect": {"error": "ValidationError"}},
    {"rule": "C3", "name": "percent-encoded host", "endpoints": {"account": "example%20.com", "basin": "example.com"}, "basin": "my-basin-1", "expect": {"error": "ValidationError"}},
    {"rule": "C3", "name": "empty DNS label", "endpoints": {"account": "a..example.com", "basin": "example.com"}, "basin": "my-basin-1", "expect": {"error": "ValidationError"}},
    {"rule": "C3", "name": "port zero", "endpoints": {"account": "example.com:0", "basin": "example.com:0"}, "basin": "my-basin-1", "expect": {"error": "ValidationError"}},
    {"rule": "C3", "name": "port out of range", "endpoints": {"account": "example.com:99999", "basin": "example.com:99999"}, "basin": "my-basin-1", "expect": {"error": "ValidationError"}},
    {"rule": "C3", "name": "empty", "endpoints": {"account": "", "basin": ""}, "basin": "my-basin-1", "expect": {"error": "ValidationError"}},
    {"rule": "C1", "name": "from_env with only the account endpoint", "env": {"S2_ACCESS_TOKEN": "token", "S2_ACCOUNT_ENDPOINT": "localhost:8080"}, "basin": "my-basin-1", "expect": {"error": "ValidationError"}},
    {"rule": "C1", "name": "from_env with only the basin endpoint", "env": {"S2_ACCESS_TOKEN": "token", "S2_BASIN_ENDPOINT": "localhost:8080"}, "basin": "my-basin-1", "expect": {"error": "ValidationError"}},
    {"rule": "C1", "name": "from_env with both endpoints", "env": {"S2_ACCESS_TOKEN": "token", "S2_ACCOUNT_ENDPOINT": "localhost:8080", "S2_BASIN_ENDPOINT": "localhost:8080"}, "basin": "my-basin-1", "expect": {"account_origin": "https://localhost:8080", "basin_origin": "https://localhost:8080", "s2_basin_header": true}},
    {"rule": "C1", "name": "from_env without endpoints", "env": {"S2_ACCESS_TOKEN": "token"}, "basin": "my-basin-1", "expect": {"account_origin": "https://a.s2.dev", "basin_origin": "https://my-basin-1.b.s2.dev", "s2_basin_header": false}},
    {"rule": "C1", "name": "from_env with empty endpoint variables", "env": {"S2_ACCESS_TOKEN": "token", "S2_ACCOUNT_ENDPOINT": "", "S2_BASIN_ENDPOINT": ""}, "basin": "my-basin-1", "expect": {"account_origin": "https://a.s2.dev", "basin_origin": "https://my-basin-1.b.s2.dev", "s2_basin_header": false}},
    {"rule": "C1", "name": "from_env with empty account endpoint and unset basin endpoint", "env": {"S2_ACCESS_TOKEN": "token", "S2_ACCOUNT_ENDPOINT": ""}, "basin": "my-basin-1", "expect": {"account_origin": "https://a.s2.dev", "basin_origin": "https://my-basin-1.b.s2.dev", "s2_basin_header": false}},
    {"rule": "C1", "name": "from_env with one endpoint and one empty endpoint", "env": {"S2_ACCESS_TOKEN": "token", "S2_ACCOUNT_ENDPOINT": "localhost:8080", "S2_BASIN_ENDPOINT": ""}, "basin": "my-basin-1", "expect": {"error": "ValidationError"}},
    {"rule": "C1", "name": "from_env without a token", "env": {"S2_ACCOUNT_ENDPOINT": "localhost:8080", "S2_BASIN_ENDPOINT": "localhost:8080"}, "basin": "my-basin-1", "expect": {"error": "ValidationError"}},
    {"rule": "C1", "name": "from_env with empty token", "env": {"S2_ACCESS_TOKEN": ""}, "basin": "my-basin-1", "expect": {"error": "ValidationError"}},
    {"rule": "C1", "name": "empty access token", "access_token": "", "basin": "my-basin-1", "expect": {"error": "ValidationError"}},
    {"rule": "C1", "name": "access token with newline", "access_token": "tok\n", "basin": "my-basin-1", "expect": {"error": "ValidationError"}},
    {"rule": "C1", "name": "access token with NUL byte", "access_token": "tok\u0000en", "basin": "my-basin-1", "expect": {"error": "ValidationError"}}
  ]
}
